        <mxCell id="title" value="&lt;b&gt;BrightPath To-Do on AWS&lt;/b&gt; · request path (orange, 1–8) and pull-based deploy path (grey, dashed)" style="text;html=1;fontSize=18;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
