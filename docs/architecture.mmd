%% Request path: how a request travels from the browser to the app and back.
flowchart LR
    user(["User's browser"])
    dns["sslip.io public DNS<br/>&lt;ip-with-dashes&gt;.sslip.io<br/>resolves to the Elastic IP"]

    subgraph aws["AWS · us-west-2"]
        subgraph vpc["VPC 10.0.0.0/16"]
            igw["Internet<br/>Gateway"]
            subgraph pub["Public subnet · SG web: inbound 80 + 443 only, no SSH"]
                subgraph ec2["EC2 t3.micro · Amazon Linux 2023 · Elastic IP · Docker Compose"]
                    caddy["Caddy<br/>:443 TLS (Let's Encrypt)<br/>:80 redirects to HTTPS"]
                    app["Flask + Gunicorn<br/>:8000, non-root container<br/>/  ·  /todos  ·  /health"]
                end
            end
            subgraph priv["Private subnets (2 AZs) · no internet route · SG db: 5432 from SG web only"]
                rds[("RDS PostgreSQL 16<br/>db.t3.micro · 20 GB gp2<br/>encrypted at rest, TLS enforced")]
            end
        end
    end

    user -- "1 · DNS lookup" --> dns
    user == "2 · HTTPS :443" ==> igw
    igw == "3" ==> caddy
    caddy == "4 · HTTP on Docker network" ==> app
    app == "5 · SQL over TLS :5432" ==> rds
    rds -. "6 · rows" .-> app
    app -. "7 · HTML / JSON" .-> caddy
    caddy -. "8 · HTTPS response" .-> user

    classDef box fill:#ffffff,stroke:#7a96ad,color:#1f2a2e
    classDef hot fill:#ffe8d6,stroke:#e8792b,color:#1f2a2e,stroke-width:2px
    classDef zone fill:#f6f9fb,stroke:#9fb3c4,color:#1f2a2e
    classDef cloud fill:#fffaf4,stroke:#e8792b,color:#1f2a2e
    class aws cloud
    class vpc,pub,priv,ec2 zone
    class dns,igw,user box
    class caddy,app,rds hot
